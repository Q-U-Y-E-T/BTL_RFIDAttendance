+/* Temporary USART1 TX-only diagnostics. PA9 -> USB-UART RX, common GND. */
+static void Test_UART_Init(void)
+{
+    GPIO_InitTypeDef pin = {0};
+    __HAL_RCC_GPIOA_CLK_ENABLE();
+    __HAL_RCC_USART1_CLK_ENABLE();
+    __HAL_RCC_USART1_FORCE_RESET();
+    __HAL_RCC_USART1_RELEASE_RESET();
+    pin.Pin = GPIO_PIN_9;
+    pin.Mode = GPIO_MODE_AF_PP;
+    pin.Speed = GPIO_SPEED_FREQ_HIGH;
+    HAL_GPIO_Init(GPIOA, &pin);
+    USART1->BRR = (HAL_RCC_GetPCLK2Freq() + 57600U) / 115200U;
+    USART1->CR1 = USART_CR1_TE | USART_CR1_UE;
+}
+
+static void Test_UART_Write(const char *text)
+{
+    uint32_t start = HAL_GetTick();
+    while (*text != '\0') {
+        while ((USART1->SR & USART_SR_TXE) == 0U) {
+            if ((uint32_t)(HAL_GetTick() - start) >= 100U) {
+                return;
+            }
+        }
+        USART1->DR = (uint8_t)*text++;
+    }
+}
 
+static void Test_PrintStatus(void)
+{
+    static const char hex[] = "0123456789ABCDEF";
+    char uid[21] = "-";
+    char line[192];
+    if (test_status == RFID_OK) {
+        for (unsigned i = 0; i < test_card.uid_len; ++i) {
+            uid[2U * i] = hex[test_card.uid[i] >> 4];
+            uid[2U * i + 1U] = hex[test_card.uid[i] & 15U];
+        }
+        uid[2U * test_card.uid_len] = '\0';
+    }
+    (void)snprintf(line, sizeof(line),
+        "READ=%u STEP=%s VER=%02lX IRQ=%02lX ERR=%02lX N=%lu SPI=%lu SPIERR=%08lX UID=%s\r\n",
+        (unsigned)test_status, rfid_debug_step,
+        (unsigned long)rfid_debug_version, (unsigned long)rfid_debug_irq,
+        (unsigned long)rfid_debug_error, (unsigned long)rfid_debug_count,
+        (unsigned long)rfid_debug_hal_status, (unsigned long)hspi1.ErrorCode, uid);
+    Test_UART_Write(line);
+}
 /* USER CODE END 0 */
 
